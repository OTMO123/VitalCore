# ============================================================================
# VITALCORE CONFIGURATION
# ============================================================================
# ⚠️  CRITICAL: This is an EXAMPLE file. DO NOT use these values in production!
# ⚠️  Copy this file to .env and replace ALL placeholder values
# ⚠️  NEVER commit .env to version control
# ============================================================================

# Application Settings
DEBUG=false
ENVIRONMENT=production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# CRITICAL: ENCRYPTION KEYS (REQUIRED)
# ============================================================================
# ⚠️  WARNING: These keys MUST be set before starting the application
# ⚠️  Random key generation has been DISABLED to prevent data loss
# ⚠️  Loss of these keys = PERMANENT LOSS of ALL encrypted PHI data
# ⚠️  Keys MUST persist across application restarts
# ⚠️  Store keys securely - NEVER commit real keys to version control
#
# Generate secure keys with:
#   python scripts/generate_encryption_keys.py
#
# For production:
#   • Use environment variables (not .env files)
#   • Store in secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
#   • Enable automated key rotation
#   • Back up keys in multiple secure locations
# ============================================================================

# Primary PHI Encryption Key (REQUIRED - must be 32+ characters)
# This key encrypts all Protected Health Information (PHI)
PHI_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY_FROM_SCRIPT

# Data Encryption Key (REQUIRED - must be 32+ characters)
# Used for encrypting data at rest
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY_FROM_SCRIPT

# Encryption Salt (REQUIRED - must be 32+ characters)
# Used for key derivation functions
ENCRYPTION_SALT=REPLACE_WITH_GENERATED_KEY_FROM_SCRIPT

# JWT Secret Key (REQUIRED - must be 32+ characters)
# Used for signing JWT authentication tokens
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_KEY_FROM_SCRIPT

# Application Secret Key (REQUIRED - must be 32+ characters)
# Used for general application security functions
SECRET_KEY=REPLACE_WITH_GENERATED_KEY_FROM_SCRIPT

# PHI Encryption Key Rotation (OPTIONAL - recommended for production)
# Secondary key for implementing key rotation without data loss
# PHI_ENCRYPTION_KEY_ROTATION=REPLACE_WITH_GENERATED_KEY_FROM_SCRIPT

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/iris_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# IRIS API Configuration
IRIS_API_BASE_URL=https://api.iris-system.com/v1
IRIS_API_KEY=your-iris-api-key
IRIS_API_SECRET=your-iris-api-secret
IRIS_API_TIMEOUT=30
IRIS_API_RETRY_ATTEMPTS=3

# Legacy encryption config - DO NOT USE
# Use PHI_ENCRYPTION_KEY, ENCRYPTION_KEY, and ENCRYPTION_SALT above instead

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_ENCRYPTION=true

# Purge Scheduler
PURGE_CHECK_INTERVAL_MINUTES=60
DEFAULT_RETENTION_DAYS=90
ENABLE_EMERGENCY_PURGE_SUSPENSION=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20